+// TQ2_0 (QK_K = 256, one fp16 scale) unpacked to a Q8_0-style int8 tile: one block == one MMQ_ITER_K step.
+// Packing (ggml-quants.c): element e -> byte 32*(e/128) + e%32, crumb (e/32)%4, value = code - 1.
+// Packed int m (0..15) of a row therefore holds output ints k = 32*(m/8) + 8*l + m%8 for crumb l = 0..3,
+// so each thread does 1 load and 4x (shift, and, perm-LUT) -> 4 tile ints. The scale d is broadcast to all
+// 8 32-value sub-blocks so the Q8_0 vec_dot (dp4a or MMA) is reused unchanged.
+template <ggml_type type, int J, bool fallback> static __device__ __forceinline__ void ggml_cuda_mmq_load_tiles_tq2_0(
+        const char * __restrict__ x, int * __restrict__ x_tile, const int kbx0, const int i_max, const int stride) {
+    constexpr int warp_size   = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps      = ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8) / warp_size;
+    constexpr int I           = ggml_cuda_mmq_get_I(type, J, fallback, GGML_PREC_Q8);
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    constexpr int sram_stride = ggml_cuda_mmq_get_sram_stride(type, J, fallback, GGML_PREC_Q8);
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_tile + 2*MMQ_TILE_NE_K);
+#else
+    constexpr tile_x_sizes txs = mmq_get_dp4a_tile_x_sizes(GGML_TYPE_Q8_0, I);
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_qs + txs.qs);
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+
+    static_assert(MMQ_ITER_K == QK_K, "TQ2_0 MMQ loader assumes one block per iteration");
+    constexpr int threads_per_row = QK_K / (4*4); // 16 packed ints per block
+    constexpr int nrows = warp_size / threads_per_row;
+    const int m = threadIdx.x % threads_per_row;
+    const int k_base = 32*(m/8) + m%8;
+
+#pragma unroll
+    for (int i0 = 0; i0 < I; i0 += nrows*nwarps) {
+        int i = i0 + threadIdx.y*nrows + threadIdx.x/threads_per_row;
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const block_tq2_0 * bxi = (const block_tq2_0 *) x + kbx0 + i*stride;
+        const int q = get_int_b2(bxi->qs, m);
+
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const uint32_t codes = (q >> (2*l)) & 0x03030303;
+#if defined(GGML_USE_HIP)
+            const int v = __builtin_amdgcn_perm(0x020100FF, 0x020100FF, codes);
+#else
+            const int v = __vsubss4(codes, 0x01010101);
+#endif // defined(GGML_USE_HIP)
+            const int k = k_base + 8*l;
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+            x_qs[i*sram_stride           + k] = v;
+#else
+            x_qs[i*(2*MMQ_TILE_NE_K + 1) + k] = v;
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        }
+    }
+
+    constexpr int blocks_per_tile_x_row = 2*MMQ_TILE_NE_K / QI8_0; // 8 scale slots per row
+    constexpr int rows_per_warp = warp_size / blocks_per_tile_x_row;
+    const int kbxd = threadIdx.x % blocks_per_tile_x_row;
+
+#pragma unroll
+    for (int i0 = 0; i0 < I; i0 += nwarps * rows_per_warp) {
+        int i = i0 + threadIdx.y * rows_per_warp + threadIdx.x / blocks_per_tile_x_row;
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const block_tq2_0 * bxi = (const block_tq2_0 *) x + kbx0 + i*stride;
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        x_df[i*sram_stride                           + kbxd] = bxi->d;
+#else
+        x_df[i*(2*MMQ_TILE_NE_K/QI8_0) + i/(QI8_0/2) + kbxd] = bxi->d;
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    }
+}
