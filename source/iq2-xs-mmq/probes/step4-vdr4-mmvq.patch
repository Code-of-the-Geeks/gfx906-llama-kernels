@@ -55,7 +112,11 @@ static constexpr __device__ vec_dot_q_cuda_t get_vec_dot_q_cuda(ggml_type type)
         case GGML_TYPE_Q5_K:    return vec_dot_q5_K_q8_1;
         case GGML_TYPE_Q6_K:    return vec_dot_q6_K_q8_1;
         case GGML_TYPE_IQ2_XXS: return vec_dot_iq2_xxs_q8_1;
+#if defined(GGML_USE_HIP) && defined(GGML_HIP_IQ2_XS_VDR4)
+        case GGML_TYPE_IQ2_XS:  return vec_dot_iq2_xs_q8_1_vdr4;
+#else
         case GGML_TYPE_IQ2_XS:  return vec_dot_iq2_xs_q8_1;
+#endif // GGML_HIP_IQ2_XS_VDR4
         case GGML_TYPE_IQ2_S:   return vec_dot_iq2_s_q8_1;
         case GGML_TYPE_IQ3_XXS: return vec_dot_iq3_xxs_q8_1;
         case GGML_TYPE_IQ1_S:   return vec_dot_iq1_s_q8_1;
