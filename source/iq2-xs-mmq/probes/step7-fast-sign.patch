+// Opt-in HIP sign application for IQ2_XS (spike step 6/7). Bit-exact replacement for unpack_ksigns + __vcmpne4 + xor + __vsub4:
+// b = per-byte sign bit (0/1; bit j of each nibble moved to bit 0 of byte j by a 24-bit multiply with 0x00204081, no overlapping
+// terms so no carries), m = per-byte 0x00/0xFF mask, signed = (g ^ m) + b. Exact because iq2xs_grid bytes are 8/25/43 (nonzero,
+// < 128): a negative byte becomes (g ^ 0xFF) + 1 = 256 - g without a carry out of the byte. Avoids the quarter-rate v_mul_lo_u32
+// of the stock path: clang lowers __umul24 to v_mul_lo_u32 on gfx906, hence the inline asm, and the mask is built as
+// (0x80808080 - b) ^ 0x80808080 because LLVM turns (b << 8) - b into b * 255. Checked exhaustively over all 65536 qs values in
+// vega20-box_mi50/spikes/iq2-xs-mmq/probes/layout-bench (sign_selftest).
+// Measured on MI50 + Qwen3.8-27B-IQ2_XS (2026-11-23, spike step 7): bit-exact (PPL identical, KLD = stock-vs-stock control);
+// tg128 +3.1%, pp512 unchanged. Per kernel (rocprofv3): fused-gate mmvq -7.5%, plain mmvq +17%. The win is the fused path only.
+static __device__ __forceinline__ uint32_t ggml_iq2xs_mul_u24(const uint32_t a, const uint32_t b) {
+    uint32_t r;
+    asm("v_mul_u32_u24 %0, %1, %2" : "=v"(r) : "v"(a), "v"(b));
+    return r;
+}
+static __device__ __forceinline__ void ggml_iq2xs_signed_grid_fast(const uint2 grid_pos, const uint32_t s7, int & grid_l, int & grid_h) {
